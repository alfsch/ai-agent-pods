# The base image of the agent images: everything they share, without an agent. install.sh pulls it from the registry
# (tag: a hash of this file and pod-environment.md, see `install.sh --base-hash`) or, when that fails or
# AGENT_POD_BUILD_BASE=1, builds it from this file. It never contains an agent: the agents are proprietary and are
# installed by each user's own build (see Dockerfile).
# Pinned by digest and kept current by Renovate (see renovate.json), which also updates the tag literals in uninstall.sh
# and the README; if you bump the tag by hand, update those too.
FROM node:26-slim@sha256:e4db4c914bf8ad241bd24804fc25d272d89bad97e68cdc8a1414862790a02c39

# git/curl/less are baseline dev tools; jq and gh are reached for by the agents' built-in workflows
# (JSON pipelines and the GitHub CLI for PRs/issues/releases). ca-certificates is needed for HTTPS.
# python3, pip and venv are for scripting; poppler-utils provides pdftotext, qpdf handles PDF
# manipulation, and tesseract-ocr does OCR (English and German language data).
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates curl less jq gh \
      python3 python3-pip python3-venv poppler-utils qpdf tesseract-ocr tesseract-ocr-eng tesseract-ocr-deu \
 && rm -rf /var/lib/apt/lists/*

# yq (mikefarah's Go implementation, not Debian's Python wrapper of the same name) isn't in apt, so
# copy the static binary out of the official multi-arch image; Docker picks the right architecture.
# The tag@digest pair is kept current by Renovate (see renovate.json), and the digest pins the exact
# image contents.
COPY --from=mikefarah/yq:4.54.1@sha256:4b3d9475d65571d28cbb19544d3820ec2945e4c8b2f18279394282b8dc3a592e /usr/bin/yq /usr/local/bin/yq

# Docker CLI (with the compose and buildx plugins) only, no daemon. Pinned by digest, kept current by Renovate. It is inert unless the launcher is run with
# DOCKER=1, which points it at a rootless Docker-in-Docker sidecar via DOCKER_HOST.
COPY --from=docker:29-cli@sha256:5e6baf67325a79f64ed3bed6863954d5e05d0f3d4e57cbdb14809346814bbfdb /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:29-cli@sha256:5e6baf67325a79f64ed3bed6863954d5e05d0f3d4e57cbdb14809346814bbfdb /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY --from=docker:29-cli@sha256:5e6baf67325a79f64ed3bed6863954d5e05d0f3d4e57cbdb14809346814bbfdb /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx

# We DO NOT use `USER node` here. Instead, we pass `--user "$(id -u):$(id -g)"` dynamically
# at runtime in the `agent-pod` script. This ensures perfect file permission alignment
# between the host and the container, especially on Linux environments.
# Create a dedicated, globally writable home directory for our dynamic runtime user.
RUN mkdir -p /home/agent-pod && chmod 777 /home/agent-pod

# What the agents should know about the environment (tools, no root, Docker only with DOCKER=1), in the places they
# read on their own. The state dirs are mounted over ~/.claude and ~/.copilot, so the usual user-level files there
# would be hidden. Claude Code reads /etc/claude-code/CLAUDE.md (managed memory; seen in /memory). Copilot CLI reads
# *.instructions.md files from the directories in COPILOT_CUSTOM_INSTRUCTIONS_DIRS; a plain AGENTS.md there was
# taken as a nested one that applies only to files below /etc/agent-pod, so the file has the front matter that
# applies it to every file. goose reads ~/.agents/AGENTS.md (its state is in the mounted ~/.goose, so this one is not
# hidden). Same text for all three.
COPY pod-environment.md /etc/claude-code/CLAUDE.md
RUN mkdir -p /etc/agent-pod \
 && { printf -- '---\napplyTo: "**"\n---\n\n'; cat /etc/claude-code/CLAUDE.md; } > /etc/agent-pod/pod-environment.instructions.md \
 && mkdir -p /home/agent-pod/.agents && cp /etc/claude-code/CLAUDE.md /home/agent-pod/.agents/AGENTS.md
ENV COPILOT_CUSTOM_INSTRUCTIONS_DIRS=/etc/agent-pod

# git credential helper: get-only, reads from a mounted file, matches by host/port/path
RUN cat > /usr/local/bin/git-credential-agent-pod <<'GIT_CRED_EOF'
#!/bin/sh
# Get-only git credential helper for agent-pod
# Reads from ${AGENT_POD_CREDENTIALS_FILE:-/run/agent-pod/git-credentials}
# Uses awk for parsing (portable BSD awk) and sh for the rest

CRED_FILE="${AGENT_POD_CREDENTIALS_FILE:-/run/agent-pod/git-credentials}"

case "$1" in
  get)
    # Read input until blank line or EOF
    protocol=""; host=""; path=""
    while IFS= read -r line; do
      [ -z "$line" ] && break
      key="${line%%=*}"
      value="${line#*=}"
      case "$key" in
        protocol) protocol="$value" ;;
        host) host="$value" ;;
        path) path="$value" ;;
      esac
    done
    
    # Try to read the credentials file
    [ -f "$CRED_FILE" ] || exit 0
    
    # Strip .git from path
    case "$path" in *.git) path="${path%.git}" ;; esac
    
    # Parse request host for port
    req_host="$host"
    req_port=""
    case "$host" in
      *:*)
        req_host="${host%%:*}"
        req_port="${host#*:}"
        ;;
    esac
    
    # Use awk to find the best match and decode %XX escapes
    # Output: username password (or nothing, decoded)
    best_match="$(awk -v protocol="$protocol" -v req_host="$req_host" -v req_port="$req_port" -v path="$path" '
    # URL-decode function: only decode %XX where XX are hex digits, leave % followed by non-hex unchanged
    function urldecode(s,    result, i, hex1, hex2, val, j, c) {
      result = ""
      i = 1
      while (i <= length(s)) {
        if (substr(s, i, 1) == "%" && i + 2 <= length(s)) {
          hex1 = substr(s, i + 1, 1)
          hex2 = substr(s, i + 2, 1)
          # Check if both are hex digits
          if ((hex1 ~ /[0-9A-Fa-f]/) && (hex2 ~ /[0-9A-Fa-f]/)) {
            val = 0
            for (j = 1; j <= 2; j++) {
              c = toupper(substr(s, i + j, 1))
              if (c ~ /[0-9]/) val = val * 16 + (c + 0)
              else val = val * 16 + (index("ABCDEF", c) + 9)
            }
            result = result sprintf("%c", val)
            i = i + 3
          } else {
            # Not a valid hex escape, keep the % and following chars
            result = result substr(s, i, 1)
            i = i + 1
          }
        } else {
          result = result substr(s, i, 1)
          i = i + 1
        }
      }
      return result
    }
    BEGIN {
      best_user = ""
      best_pass = ""
      best_len = -1
    }
    {
      # Skip comments and blank lines
      if ($0 ~ /^[[:space:]]*#/ || $0 ~ /^[[:space:]]*$/) next
      
      # Must start with https://
      if (substr($0, 1, 8) != "https://") next
      
      line = substr($0, 9)
      
      # Find @
      at_pos = index(line, "@")
      if (at_pos == 0) next
      
      creds = substr(line, 1, at_pos - 1)
      hpp = substr(line, at_pos + 1)
      
      # Split user:token at first colon
      colon_pos = index(creds, ":")
      if (colon_pos == 0) next
      
      user = urldecode(substr(creds, 1, colon_pos - 1))
      token = urldecode(substr(creds, colon_pos + 1))
      
      # Extract port from hpp
      port = ""
      # Look for :<digits> at the end or before /
      if (hpp ~ /:[0-9]+$/) {
        # Port at end
        port = substr(hpp, length(hpp) - length(substr(hpp, index(hpp, ":") + 1)) + 1)
        hpp = substr(hpp, 1, index(hpp, ":") - 1)
      } else if (hpp ~ /:[0-9]+\//) {
        # Port before /
        colon_pos = index(hpp, ":")
        slash_pos = index(hpp, "/")
        port = substr(hpp, colon_pos + 1, slash_pos - colon_pos - 1)
        hpp = substr(hpp, 1, colon_pos - 1) substr(hpp, slash_pos)
      }
      
      # Extract path
      cred_path = ""
      slash_pos = index(hpp, "/")
      if (slash_pos > 0) {
        cred_path = substr(hpp, slash_pos + 1)
        hpp = substr(hpp, 1, slash_pos - 1)
      }
      
      cred_host = hpp
      
      # Check protocol
      if (protocol != "https") next
      
      # Check host match
      if (cred_host != req_host) next
      
      # Check port match
      if (port != "" && port != req_port) next
      if (port == "" && req_port != "") next
      
      # Check path match
      if (cred_path == "") {
        # Host-level line - fallback
        if (best_len < 0) {
          best_user = user
          best_pass = token
          best_len = 0
        }
      } else {
        if (path == cred_path) {
          best_user = user
          best_pass = token
          best_len = length(cred_path)
        } else if (substr(path, 1, length(cred_path) + 1) == cred_path "/") {
          if (length(cred_path) > best_len) {
            best_user = user
            best_pass = token
            best_len = length(cred_path)
          }
        }
      }
    }
    END {
      if (best_user != "") {
        printf "%s\n%s\n", best_user, best_pass
      }
    }
    ' "$CRED_FILE")"
    
    # If we found a match, output it with username= and password= prefixes (already decoded by awk)
    if [ -n "$best_match" ]; then
      user="$(printf '%s' "$best_match" | head -1)"
      pass="$(printf '%s' "$best_match" | tail -1)"
      printf 'username=%s\npassword=%s\n' "$user" "$pass"
    fi
    ;;
  store|erase)
    # No-op: read-only mount, cannot write
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
GIT_CRED_EOF
RUN chmod 755 /usr/local/bin/git-credential-agent-pod

# Interactive-shell setup, appended to /etc/bash.bashrc. Only interactive bash sources this file, so
# none of it touches the non-interactive `agent-pod <agent> ...` path. The dynamic, /etc/passwd-less
# user has no $HOME/.bashrc of its own, so these baseline conveniences have to live in the system-wide
# rc. Heredoc keeps the escapes readable (BuildKit, which install.sh already requires via
# --progress=plain, supports it).
RUN cat >> /etc/bash.bashrc <<'EOF'

# Colored prompt: green label, blue path — the conventional Debian default look. \[...\] wraps the
# non-printing escapes so bash measures the prompt width correctly. The "agent-pod" label also
# hides the "I have no name!" warning a dynamic, passwd-less user would otherwise show.
PS1='\[\e[1;32m\]agent-pod\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]\$ '

# Basic, conventional coloring for the most-used commands. dircolors supplies the standard LS_COLORS
# palette; the aliases enable color only when output is a terminal (so piped output stays clean).
if command -v dircolors >/dev/null 2>&1; then eval "$(dircolors -b)"; fi
alias ls='ls --color=auto'
alias grep='grep --color=auto'
EOF

CMD ["bash"]
